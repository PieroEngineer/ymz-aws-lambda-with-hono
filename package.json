{
  "name": "ymz_be_hono",
  "version": "1.0.0",
  "description": "Yummizi Engine Backend API",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "cross-env LOCALSTACK_ENDPOINT=http://localhost:4566 NODE_ENV=development tsx watch src/server.dev.ts",
    "seed": "cross-env LOCALSTACK_ENDPOINT=http://localhost:4566 tsx src/scripts/seed.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.js --external:@aws-sdk/* --external:@hono/node-server",
    "deploy:local": "npm run build && cd dist && zip -r handler.zip index.js && docker cp handler.zip localstack_yummizi:/tmp/handler.zip && docker exec localstack_yummizi awslocal lambda update-function-code --function-name YummiziHonoBackend --zip-file fileb:///tmp/handler.zip"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1063.0",
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/lib-dynamodb": "^3.1064.0",
    "@aws-sdk/s3-request-presigner": "^3.1068.0",
    "@hono/node-server": "^2.0.4",
    "hono": "^4.12.24"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}